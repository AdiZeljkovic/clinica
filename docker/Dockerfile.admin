# Bioclinica admin panel — Vite build + nginx
FROM node:22-slim AS build
WORKDIR /app
COPY admin/package.json admin/package-lock.json ./
RUN npm ci
COPY admin/ ./
# VITE_* se peče u build — /api ide kroz nginx proxy admin domena
ARG VITE_API_URL=/api
# Javni URL frontenda — za preview /slike/... putanja u admin formama
ARG VITE_FRONTEND_URL=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_FRONTEND_URL=$VITE_FRONTEND_URL
RUN npm run build

FROM nginx:alpine
COPY docker/nginx-admin.conf /etc/nginx/conf.d/default.conf
# admin/vite.config.ts builda u ../dist-admin (relativno na admin root = /dist-admin)
COPY --from=build /dist-admin /usr/share/nginx/html
EXPOSE 80
