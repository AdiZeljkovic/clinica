# Bioclinica — environment varijable
# Lokalni dev: kopiraj u .env i popuni.
# Deploy (Dokploy): postavi u panelu — vidi deploy.md. Tajne NIKAD u repo.

# Baza podataka (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bioclinica

# JWT (npr. openssl rand -base64 32)
JWT_SECRET=

# API server (u kontejneru se koristi PORT)
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:3002,http://localhost:3001

# Admin kredencijali — upsertuju se u bazu na svakom bootu API-ja
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Vite (peče se u build!) — lokalni dev; u Dockeru je fiksno /api
VITE_API_URL=http://localhost:4000/api

# Javni URL frontenda (build arg za admin preview slika)
SITE_URL=

# SMTP — kontakt forma šalje mail na CONTACT_EMAIL (bez SMTP_HOST poruke idu samo u bazu)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=adriaticsm@sunwavepharma.com
