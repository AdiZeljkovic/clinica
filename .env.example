# Bioclinica - Environment varijable
# Kopiraj u .env i popuni vrijednosti

# Baza podataka
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=

# Server
SERVER_PORT=4000
CORS_ORIGIN=

# Vite (samo za lokalni dev — na serveru postaviti VITE_API_URL PRIJE builda)
VITE_API_URL=
